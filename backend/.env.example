PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/family-health-memory?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
# Optional: choose a currently available Gemini model.
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:8080,https://your-frontend.vercel.app
# Base URL for invitation accept links (email / copy-link flow).
FRONTEND_URL=http://localhost:8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JSON_BODY_LIMIT=1mb
# Global HTTP rate limit (all /api traffic per IP). Default 8000 per window supports polling + UI.
# RATE_LIMIT_MAX=8000
# RATE_LIMIT_WINDOW_MS=900000
MAX_AUDIO_FILE_BYTES=8388608
# Voice: OpenAI Whisper (primary) + Gemini fallback for transcription; Gemini for tag extraction.
OPENAI_API_KEY=
# Optional ISO-639-1 language code (e.g. en) to bias Whisper when family language is fixed.
OPENAI_WHISPER_LANGUAGE=
# Optional absolute path for persisted audio files (default: backend/data/voice-artifacts).
VOICE_STORAGE_DIR=
