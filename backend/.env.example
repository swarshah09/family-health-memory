PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/family-health-memory?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
# Optional: choose a currently available Gemini model.
GEMINI_MODEL=gemini-2.5-flash
CORS_ORIGINS=http://localhost:8080,https://your-frontend.vercel.app
# Base URL for invitation accept links (email / copy-link flow).
FRONTEND_URL=http://localhost:8080
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JSON_BODY_LIMIT=1mb
# Global HTTP rate limit (all /api traffic per IP). Default 8000 per window supports polling + UI.
# RATE_LIMIT_MAX=8000
# RATE_LIMIT_WINDOW_MS=900000
MAX_AUDIO_FILE_BYTES=8388608
# Voice: OpenAI Whisper (primary) + Gemini fallback for transcription; Gemini for tag extraction.
OPENAI_API_KEY=
# Optional ISO-639-1 language code (e.g. en) to bias Whisper when family language is fixed.
OPENAI_WHISPER_LANGUAGE=
# Optional absolute path for persisted audio files (default: backend/data/voice-artifacts).
VOICE_STORAGE_DIR=

# WhatsApp Cloud API (Meta) — input channel for health memory ingestion
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app secret — required in production for X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=
# Max webhook POST body (express raw parser)
WHATSAPP_WEBHOOK_BODY_LIMIT=256kb
WHATSAPP_WEBHOOK_RATE_MAX=120
# Default region when users omit country code (ISO 3166-1 alpha-2, e.g. US, IN, GB)
WHATSAPP_DEFAULT_PHONE_REGION=US
