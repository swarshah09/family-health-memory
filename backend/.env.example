PORT=4000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/family-health-memory?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=your-gemini-api-key
# Optional: gemini-2.0-flash (default), gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-2.0-flash
CORS_ORIGINS=http://localhost:8080,https://your-frontend.vercel.app
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
JSON_BODY_LIMIT=1mb
MAX_AUDIO_FILE_BYTES=8388608
